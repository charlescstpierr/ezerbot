   546	  function upsertConversation(conversation) {
   547	    const index = state.conversations.findIndex((item) => item.id === conversation.id);
   548	    if (index === -1) state.conversations.unshift(conversation);
   549	    else state.conversations[index] = conversation;
   550	    observeSavedConversation(conversation);
   551	    connected = true;
   552	    connectionStatus = "online";
   553	    ui.banner.hidden = true;
   554	  }
