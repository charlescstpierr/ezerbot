   467	  let refreshWork;
   468	  function refresh() {
   469	    if (!refreshWork) refreshWork = loadState().finally(() => { refreshWork = null; });
   470	    return refreshWork;
   471	  }
   472	  async function loadState() {
   473	    const previous = currentConversation();
   474	    const wasLive = Boolean(streamingMessage(previous));
   475	    const previousTail = previous?.messages.at(-1)?.id;
   476	    state = await api("/api/state");
   477	    for (const conversation of state.conversations) observeSavedConversation(conversation);
   478	    if (!preferencesLoaded) {
   479	      preferencesLoaded = true;
   480	      applyTheme(state.preferences?.theme || themeChoice);
   481	      applyAccent(state.preferences?.accent || accentChoice);
   482	    }
   483	    connected = true;
   484	    connectionStatus = "online";
   485	    ui.banner.hidden = true;
   486	    for (const panel of panels.values()) panelCall(panel, panel.onConnection, true);
   487	    if (selectedId && !state.conversations.some((item) => item.id === selectedId)) selectedId = null;
   488	    writePreference("grokbot.selected", selectedId || "");
   489	    const pinned = ui.scroll.scrollHeight - ui.scroll.scrollTop - ui.scroll.clientHeight < 90;
   490	    const current = currentConversation();
   491	    // A terminal error (or a one-chunk success) may never have a streaming DOM
   492	    // frame. Follow the transition after React commits, not just live deltas.
   493	    render(pinned && (Boolean(streamingMessage()) || (current?.id === previous?.id && (wasLive || current?.messages.at(-1)?.id !== previousTail))));
   494	    schedulePoll();
   495	  }
   496	
   497	  // The engine writes a reply while it streams; the shell re-reads it until every reply settles.
   498	  function schedulePoll() {
   499	    clearTimeout(pollTimer);
   500	    const live = state.conversations.some((conversation) => streamingMessage(conversation));
   501	    const waiting = provider().signin === "pending" || provider().connection_test?.state === "running" || provider().titling || (provider().connected && !provider().models_ready);
   502	    const panelWaiting = [...panels.values()].some((panel) => panelCall(panel, panel.wantsPolling) === true);
   503	    // A failed refresh must never disarm recovery. An idle heartbeat also
   504	    // notices a wrapper restart or a run started by another window.
   505	
   506	    pollTimer = setTimeout(async () => {
   507	      if (busy) { schedulePoll(); return; }
   508	      try {
   509	        if (live || waiting || !connected) await refresh();
   510	        else {
   511	          // Idle liveness must not serialize/repaint the entire workspace.
   512	          const ping = await api("/api/ping");
   513	          if (ping.revision !== state.state_revision) await refresh();
   514	          else {
   515	            for (const panel of panels.values()) if (panelCall(panel, panel.wantsPolling) === true) panelCall(panel, panel.onState, state);
   516	            schedulePoll();
   517	          }
   518	        }
   519	      } catch (error) {
   520	        if (error?.accessDisabled) showConnectionError(error);
   521	        schedulePoll();
   522	      }
   523	    }, !connected ? 1500 : live ? 200 : waiting || panelWaiting ? 800 : 5000);
   524	  }
   525	
   526	  function remoteAccessDisabled(status, data) {
   527	    const message = String(data?.error || "").replaceAll("'", "’");
   528	    return Boolean(window.EzerbotIPhone?.remote && status === 403 && message === "L’accès iPhone est désactivé sur le Mac.");
   529	  }
   530	
   531	  function showConnectionError(error) {
   532	    connected = false;
   533	    connectionStatus = error?.accessDisabled ? "disabled" : "offline";
   534	    ui.bannerText.textContent = error?.accessDisabled
   535	      ? "L’accès iPhone est désactivé sur le Mac. Réactivez-le dans Paramètres › iPhone. Reconnexion automatique…"
   536	      : window.EzerbotIPhone?.remote
   537	      ? "Mac injoignable. Vérifiez que le Mac est allumé, Ezerbot ouvert et Tailscale connecté. Reconnexion automatique…"
   538	      : "Le moteur local ne répond plus. Vos conversations enregistrées sont conservées.";
   539	    ui.banner.hidden = false;
   540	    render();
   541	    for (const panel of panels.values()) panelCall(panel, panel.onConnection, false);
   542	    schedulePoll();
   543	    if (error) console.warn("Ezerbot local connection:", error.message);
   544	  }
