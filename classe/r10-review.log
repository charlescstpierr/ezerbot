    19	
    20	const roots = new WeakMap();
    21	if (document.getElementById("floating-root")) mountFloating(document.getElementById("floating-root"));
    22	
    23	// The shell (app.js) owns state and transport; this bundle draws the thread and the message field.
    24	window.GrokbotChat = {
    25	  createVoiceReader, voiceNeedsAction,
    26	  demonstrationSummaryView,
    27	  createDeepLinkQueue,
    28	  sourceOpening,
    29	  teachPrompt: TEACH_PROMPT,
    30	  isTeachMessage,
    31	  searchableMessageText,
    32	  exportMessage,
    33	  findInRendered,
    34	  cycleFind,
    35	  findCountLabel,
    36	  createRatingTable,
    37	  createNativeRatingTable,
    38	  createApprovalFollow,
    39	  revealPendingApproval,
