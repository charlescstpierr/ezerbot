    47	    if (!roots.has(container)) roots.set(container, createRoot(container));
    48	    roots.get(container).render(<Thread {...props} />);
    49	  },
    50	
    51	  // Returns a stand-in for the former <textarea>.
    52	  mountInput(element, { placeholder, onInput, onSubmit, onFiles, getMentionCandidates = () => [], onAddMember = async () => false, createMentionAvatar, mentionSummary }) {
    53	    const menu = mentionMenu(element, getMentionCandidates, onAddMember, createMentionAvatar, mentionSummary);
    54	    let currentPlaceholder = placeholder;
    55	    const options = editorOptions({ placeholder: () => currentPlaceholder, onSubmit });
    56	    const editor = new Editor({
    57	      element, ...options, onUpdate: ({ editor }) => { onInput(); menu.update(editor); },
    58	      onSelectionUpdate: ({ editor }) => menu.update(editor),
    59	      onBlur: () => setTimeout(() => menu.hide(), 150),
    60	      editorProps: {
    61	        ...options.editorProps,
    62	        handleKeyDown: (view, event) => menu.keydown(editor, event) || options.editorProps.handleKeyDown(view, event),
    63	        handlePaste: (_view, event) => Boolean(onFiles?.(event.clipboardData?.files, event)),
    64	        handleDrop: (_view, event) => Boolean(onFiles?.(event.dataTransfer?.files, event)),
    65	      },
    66	    });
    67	    return {
    68	      get value() { return readText(editor); },
    69	      set value(text) { menu.hide(); writeText(editor, text); },
    70	      appendText(text) {
    71	        editor.chain().focus("end").insertContent({ type: "paragraph", content: [{ type: "text", text }] }).run();
    72	      },
    73	      get mentions() { return readMentions(editor); },
    74	      get document() { return editor.getJSON(); },
    75	      set document(value) { menu.hide(); editor.commands.setContent(value, { emitUpdate: false }); },
    76	      focus() { if (editor.isEditable) editor.commands.focus("end"); },
    77	      setReadOnly(readOnly) {
    78	        if (readOnly) menu.hide();
    79	        if (editor.isEditable === readOnly) editor.setEditable(!readOnly, false);
    80	        editor.view.dom.setAttribute("aria-disabled", String(readOnly));
    81	      },
    82	      setPlaceholder(text) {
    83	        if (currentPlaceholder === text) return;
    84	        currentPlaceholder = text;
    85	        editor.view.dispatch(editor.state.tr);
    86	      },
    87	      setInvalid(invalid) { editor.view.dom.setAttribute("aria-invalid", String(invalid)); },
    88	    };
    89	  },
    90	};
