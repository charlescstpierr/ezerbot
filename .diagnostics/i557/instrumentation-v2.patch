+use std::cell::{Cell, RefCell};
+use std::io::Write;
+use std::path::{Path, PathBuf};
+use std::sync::{OnceLock, atomic::{AtomicU64, Ordering}};
+use std::time::Instant;
+
+/// Identifies the temporary diagnostic collector.
+pub const SENSOR: &str = "i557-tls-v1";
+static ORIGIN: OnceLock<Instant> = OnceLock::new();
+static DIRECTORY: OnceLock<Option<PathBuf>> = OnceLock::new();
+static THREAD: AtomicU64 = AtomicU64::new(1);
+
+#[derive(Clone, Copy, Default)]
+/// Numeric correlation context, with no user data.
+pub struct Context {
+    /// Pseudonym of the fixture directory.
+    pub fixture: u64,
+    /// Pseudonym of the durable run.
+    pub run: u64,
+    /// Fake server request ordinal.
+    pub request: u64,
+    /// Observer poll ordinal.
+    pub poll: u64,
+}
+struct Row {
+    t: u128,
+    context: Context,
+    phase: &'static str,
+    a: u64,
+    b: u64,
+    ok: bool,
+}
+struct Buffer {
+    thread: u64,
+    rows: Vec<Row>,
+    overhead: u128,
+}
+thread_local! {
+    static CONTEXT: Cell<Context> = Cell::new(Context::default());
+    static BUFFER: RefCell<Buffer> = RefCell::new(Buffer {
+        thread: THREAD.fetch_add(1, Ordering::Relaxed),
+        rows: Vec::with_capacity(1024),
+        overhead: 0,
+    });
+}
+fn directory() -> Option<&'static PathBuf> {
+    DIRECTORY.get_or_init(|| std::env::var_os("I557_TRACE_DIR").map(PathBuf::from)).as_ref()
+}
+/// Copies this thread's context.
+pub fn context() -> Context { CONTEXT.with(Cell::get) }
+/// Attaches a copied context to a thread.
+pub fn set(context: Context) { CONTEXT.with(|c| c.set(context)); }
+/// Produces a stable opaque identifier.
+pub fn hash(value: &str) -> u64 {
+    value.bytes().fold(14695981039346656037, |n, b| (n ^ u64::from(b)).wrapping_mul(1099511628211))
+}
+/// Attaches the database directory's pseudonym.
+pub fn fixture(path: &Path) {
+    let mut c = context();
+    c.fixture = hash(&path.parent().unwrap_or(path).to_string_lossy());
+    set(c);
+}
+/// Attaches the current run's pseudonym.
+pub fn run(value: Option<&str>) {
+    let mut c = context();
+    c.run = value.map_or(0, hash);
+    set(c);
+}
+/// Attaches the fake server request ordinal.
+pub fn request(value: u64) {
+    let mut c = context(); c.request = value; set(c);
+}
+/// Attaches the observer poll ordinal.
+pub fn poll(value: u64) {
+    let mut c = context(); c.poll = value; set(c);
+}
+/// Records a closed phase with numeric counters.
+pub fn mark(phase: &'static str, a: u64, b: u64, ok: bool) {
+    row(context(), phase, a, b, ok);
+}
+/// Records a phase for an explicit run without changing the context.
+pub fn mark_run(run: &str, phase: &'static str, a: u64, b: u64, ok: bool) {
+    let mut c = context(); c.run = hash(run); row(c, phase, a, b, ok);
+}
+/// Records the exact observer instant or sleep deadline on the shared clock.
+pub fn deadline(phase: &'static str, instant: Instant, a: u64) {
+    let origin = *ORIGIN.get_or_init(Instant::now);
+    mark(phase, instant.saturating_duration_since(origin).as_nanos() as u64, a, true);
+}
+fn row(context: Context, phase: &'static str, a: u64, b: u64, ok: bool) {
+    if directory().is_none() { return; }
+    let start = Instant::now();
+    let origin = ORIGIN.get_or_init(Instant::now);
+    let t = origin.elapsed().as_nanos();
+    BUFFER.with(|buffer| {
+        let mut buffer = buffer.borrow_mut();
+        buffer.rows.push(Row { t, context, phase, a, b, ok });
+        buffer.overhead += start.elapsed().as_nanos();
+    });
+}
+impl Drop for Buffer {
+    fn drop(&mut self) {
+        if self.rows.is_empty() { return; }
+        let Some(directory) = directory() else { return; };
+        let result = (|| -> std::io::Result<()> {
+            std::fs::create_dir_all(directory)?;
+            let mut output = std::io::BufWriter::new(std::fs::File::create(directory.join(format!("thread-{}.tsv", self.thread)))?);
+            writeln!(output, "sensor\t{SENSOR}\tthread\t{}", self.thread)?;
+            writeln!(output, "ns\tfixture\trun\trequest\tpoll\tphase\ta\tb\tok")?;
+            for row in &self.rows {
+                let c = row.context;
+                writeln!(output, "{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}\t{}", row.t, c.fixture, c.run, c.request, c.poll, row.phase, row.a, row.b, u8::from(row.ok))?;
+            }
+            writeln!(output, "END\t{}\t{}", self.rows.len(), self.overhead)?;
+            output.flush()?;
+            Ok(())
+        })();
+        eprintln!("I557_FLUSH sensor={SENSOR} thread={} rows={} ok={}", self.thread, self.rows.len(), result.is_ok());
+    }
+}
