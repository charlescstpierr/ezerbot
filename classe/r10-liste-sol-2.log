     1	// REA desktop.deep_links: listener before readiness, 16 queued links and a 2s
     2	// canonical dedup window. Volatile navigation only: no automatic send or replay
     3	// after an application restart. The Rust resolver is the grammar/access authority.
     4	export function createDeepLinkQueue({ resolve, navigate, report, generation = () => 0, now = Date.now, capacity = 16 }) {
     5	  const pending = [], seen = new Map();
     6	  let ready = false, draining = false;
     7	  async function drain() {
     8	    if (!ready || draining) return;
     9	    draining = true;
    10	    try {
    11	      while (ready && pending.length) {
    12	        const entry = pending.shift(), { raw } = entry;
    13	        try {
    14	          const expected = entry.expected ?? generation();
    15	          const link = entry.link || await resolve(raw);
    16	          if (link.duplicate) continue;
    17	          if (generation() !== expected) { report("Navigation annulée : vous avez changé de vue pendant l’ouverture du lien."); continue; }
    18	          if (!ready) { pending.unshift({ raw, link, expected }); break; }
    19	          const at = now();
    20	          for (const [key, time] of seen) if (at - time >= 2000) seen.delete(key);
    21	          if (seen.has(link.canonical)) continue;
    22	          if (seen.size >= capacity) { report("Trop de liens reçus. Réessayez dans quelques secondes."); continue; }
    23	          seen.set(link.canonical, at);
    24	          await navigate(link.destination);
    25	        } catch (error) { report(error.message || "Ce lien n’a pas pu être ouvert."); }
    26	      }
    27	    } finally { draining = false; }
    28	  }
    29	  return {
    30	    receive(raw) {
    31	      if (typeof raw !== "string" || raw.length > 2048) { report("Ce lien Ezerbot est invalide ou trop long."); return true; }
    32	      if (pending.some((entry) => entry.raw === raw)) return true;
    33	      if (pending.length >= capacity) { report("Trop de liens en attente. Rouvrez ce lien après le démarrage."); return true; }
    34	      pending.push({ raw }); void drain();
    35	      return true;
    36	    },
    37	    setReady(value) { ready = Boolean(value); void drain(); },
    38	    // Deterministic test checkpoint, not a separate routing implementation.
    39	    async idle() { while (draining) await new Promise((done) => setTimeout(done, 0)); },
    40	  };
    41	}

