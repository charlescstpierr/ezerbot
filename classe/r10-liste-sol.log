   645	  // All staged attachments, including voice memos, belong to this bot/thread.
   646	  function stagedOnEmptyThread() {
   647	    return Boolean(!currentConversation()?.messages.length && $("composer-attachments").querySelector(".attachment-chip, .voice-memo-chip"));
   648	  }
