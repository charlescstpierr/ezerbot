     1	import { useEffect } from "react";
     2	import { EditorContent, useEditor } from "@tiptap/react";
     3	import StarterKit from "@tiptap/starter-kit";
     4	import Placeholder from "@tiptap/extension-placeholder";
     5	import { ArrowUp } from "lucide-react";
     6	
     7	// Rich-text message field: Markdown shortcuts while typing (**gras**, `code`, listes, ```).
     8	export function Composer({ disabled = false, placeholder = "Qu’avez-vous en tête ?", onSend }) {
     9	  const editor = useEditor({
    10	    extensions: [StarterKit.configure({ heading: false, horizontalRule: false }), Placeholder.configure({ placeholder })],
    11	    editorProps: {
    12	      attributes: { class: "gb-editor", "aria-label": "Votre message", role: "textbox", "aria-multiline": "true" },
    13	      handleKeyDown(view, event) {
    14	        if (event.key !== "Enter" || event.shiftKey || event.isComposing) return false;
    15	        if (view.state.selection.$from.parent.type.name === "codeBlock") return false;
    16	        event.preventDefault();
    17	        submit();
    18	        return true;
    19	      },
    20	    },
    21	  });
    22	  const empty = !editor || editor.isEmpty;
    23	
    24	  function submit() {
    25	    if (!editor || editor.isEmpty || disabled) return;
    26	    onSend(editor.getText({ blockSeparator: "\n" }).trim());
    27	    editor.commands.clearContent(true);
    28	  }
    29	
    30	  useEffect(() => { editor?.setEditable(!disabled); }, [editor, disabled]);
    31	
    32	  return (
    33	    <form className="gb-composer" onSubmit={(event) => { event.preventDefault(); submit(); }}>
    34	      <EditorContent editor={editor} />
    35	      <div className="gb-composer-bottom">
    36	        <span className="gb-composer-hint">Entrée pour envoyer · ⇧ Entrée pour une nouvelle ligne</span>
    37	        <button type="submit" className="gb-send" aria-label="Envoyer le message" disabled={empty || disabled}><ArrowUp /></button>
    38	      </div>
    39	    </form>
    40	  );
    41	}
