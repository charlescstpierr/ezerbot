   617	    deepLinks.setReady(deepLinksBootReady && connected && !busy);
   618	    $("restore-link-draft").hidden = Boolean(selectedId) || previousLinkDrafts().length === 0;
   619	    const learn = $("learn-skill-button");
   620	    learn.hidden = ["task", "routine"].includes(currentConversation()?.kind);
   621	    learn.disabled = busy || !connected || pending || noMembers || Boolean(streamingMessage())
   622	      || !currentConversation()?.messages.some((message) => message.role === "user" && ["accepted", "echoed"].includes(message.state));
   623	    mascot?.setContext({ connection: connected ? "online" : connectionStatus,
   624	      activity: taskFinished || control.offline ? null : submissionActivity, pending: taskFinished || control.offline ? null : pendingMessage?.state || null, drafting: !taskFinished && !attachmentsBlocked && Boolean(ui.input.value.trim()) });
   625	  }
