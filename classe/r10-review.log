   337	fn route(app: &mut App, path: &str, body: &[u8]) -> Result<Value, ApiError> {
   338	    match path {
   339	        "/api/send" => {
   340	            let input: SendMessage = parse(body)?;
   341	            validate_conversation_id(&input.conversation_id)?;
   342	            validate_id(&input.message_id)?;
   343	            app.require_conversation(&input.conversation_id)?;
   344	            super::delegation::ensure_send_allowed(&app.feature_context(), &input.conversation_id)?;
   345	            for id in &input.attachments {
   346	                validate_id(id)?;
   347	            }
   348	            let text = input.body.trim();
   349	            let conversation = ConversationId::new(&input.conversation_id).expect("validated");
   350	            let message = MessageId::new(&input.message_id).expect("validated");
   351	            let previous = app.session.state(&conversation, &message)?;
   352	            if (previous.is_none() && text.is_empty() && input.attachments.is_empty())
   353	                || text.len() > 16 * 1024
   354	            {
   355	                return Err(ApiError::new(
   356	                    400,
   357	                    "Ajoutez du texte (16 Ko au plus) ou un fichier.",
   358	                ));
   359	            }
   360	            // Le journal n'est écrit qu'après le commit : après un crash entre les deux,
   361	            // seule l'entrée du fil prouve que le premier envoi (ancre comprise) est durable.
   362	            let resend = previous.is_some()
   363	                || super::conversations::has_submission(
   364	                    &app.connection,
   365	                    &input.conversation_id,
   366	                    &input.message_id,
   367	                )?;
   368	            if resend {
   369	                super::pages::anchors::check_resend(
   370	                    &app.connection,
   371	                    &input.conversation_id,
   372	                    &input.message_id,
   373	                    input.page_anchor.as_ref(),
   374	                )?;
   375	            }
   376	            let prepared = if previous.is_some() {
   377	                Some(
   378	                    app.session
   379	                        .prepare(conversation.clone(), message.clone(), text.into())?,
   380	                )
   381	            } else {
   382	                None
   383	            };
   384	            let tx = super::write_transaction(&app.connection)?;
   385	            super::multibot::capture(
   386	                &tx,
   387	                &input.conversation_id,
   388	                &input.message_id,
   389	                &input.mentions,
   390	                text,
   391	                app.provider.connected() || !app.provider.simulation_allowed(),
   392	            )?;
   393	            if let Some(skill_id) = &input.apply_skill_id {
   394	                super::skills::record_launch(
