   297	  async function navigateLink(destination) {
   298	    // Never discard an unsaved editor or silently substitute another target.
   299	    const botEdited = $("bot-dialog").open && (JSON.stringify(botFormValues()) !== botDialogInitial
   300	      || Boolean($("bot-extensions").querySelector(".memory-editor:not([hidden])")));
   301	    if (botEdited || document.querySelector("#rename-dialog[open], .skills-dialog[open], .routines-dialog[open], dialog.gb-file-save:not(.gb-file-zoom)[open]")) {
   302	      throw new Error("Fermez l’éditeur en cours, puis rouvrez ce lien. Vos saisies sont conservées.");
   303	    }
   304	    for (const dialog of document.querySelectorAll("dialog[open]")) dialog.close();
   305	    const { kind, id, agent } = destination;
   306	    if (kind === "conversation") {
   307	      if (!state.conversations.some((item) => item.id === id)) throw new Error("Cette conversation est introuvable ou inaccessible sur ce Mac.");
   308	      selectConversation(id, true);
   309	    } else if (kind === "bot") {
   310	      const bot = botById(id);
   311	      if (!bot || bot.deleted) throw new Error("Ce bot est introuvable ou inaccessible sur ce Mac.");
   312	      openBotDialog(bot);
   313	    } else if (kind === "settings") {
   314	      $("settings-dialog").showModal();
   315	      for (const panel of panels.values()) panelCall(panel, panel.onSettingsLink, id);
   316	      const target = ({ account: $("provider-section"), appearance: $("settings-appearance"), bots: $("settings-bots"), shortcuts: $("settings-shortcuts") })[id]
   317	        || $("settings-extensions").querySelector(`[data-panel="${id}"]`);
   318	      focusLinkTarget(target);
   319	    } else if (kind === "routine" || kind === "skill") {
   320	      const bot = botById(agent);
   321	      if (!bot || bot.deleted) throw new Error("Ce bot est introuvable ou inaccessible sur ce Mac.");
   322	      if (kind === "skill") openBotDialog(bot);
   323	      const panel = panels.get(kind === "skill" ? "skills" : "routines");
   324	      if (!panel?.openLink || await panel.openLink({ id, agent }) === false) throw new Error("La cible de ce lien est introuvable ou inaccessible sur ce Mac.");
   325	    } else if (kind === "bot_template") {
   326	      if (await panels.get("templates")?.openLink?.(destination) !== true) throw new Error("Ce modèle de bot est introuvable ou son lien est abîmé.");
   327	    } else if (kind === "compose") {
   328	      if (agent && (!botById(agent) || botById(agent).deleted)) throw new Error("Ce bot est introuvable ou inaccessible sur ce Mac.");
   329	      if (stagedOnEmptyThread() || sendExtras().attachments?.length) throw new Error("Retirez les pièces jointes en cours ou envoyez-les vous-même avant de rouvrir ce lien. Rien n’a été envoyé.");
   330	      const newDraftText = selectedId ? readPreference(draftKey(null), "") : ui.input.value;
   331	      if (previousLinkDrafts().length >= 16 && newDraftText) throw new Error("Reprenez d’abord un brouillon précédent avant d’ouvrir un autre lien contenant du texte.");
   332	      selectConversation(null);
   333	      if (ui.input.value) {
   334	        previousLinkDrafts().push({ text: ui.input.value, document: ui.input.document, bot: chosenBotId });
   335	        saveLinkDrafts();
   336	      }
   337	      chosenBotId = agent || chosenBot()?.id;
   338	      writePreference("grokbot.bot", chosenBotId);
   339	      setComposerText(destination.text); saveDraft(); render(); ui.input.focus();
   340	      notify("Texte placé dans le brouillon. Rien n’a été envoyé.");
   341	    }
   342	  }
