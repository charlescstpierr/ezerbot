   582	  function updateComposer() {
   583	    const pendingMessage = currentConversation()?.messages.find((message) => message.role === "user" && pendingStates.has(message.state));
   584	    const pending = Boolean(pendingMessage);
   585	    const group = currentConversation()?.kind === "group";
   586	    const task = currentConversation()?.kind === "task";
   587	    const taskFinished = task && !window.GrokbotDelegation?.canFollowUp(currentConversation().id);
   588	    ui.input.setReadOnly(taskFinished);
   589	    ui.input.setPlaceholder(task ? "Écrire un suivi pour cette sous-tâche…" : "Qu’avez-vous en tête ?");
   590	    if (taskFinished) {
   591	      if (ui.input.value) setComposerText("");
   592	      removePreference(draftKey());
   593	      removePreference(`${draftKey()}.document`);
   594	      for (const panel of panels.values()) panelCall(panel, panel.composer?.discard);
   595	      if (document.activeElement?.closest?.(".composer-area")) document.querySelector(".gb-delegation-bar p")?.focus();
   596	    }
   597	    const tooLong = new TextEncoder().encode(ui.input.value.trim()).length > 16 * 1024;
   598	    const hasAttachments = Boolean(sendExtras().attachments?.length);
   599	    const blockingPanel = [...panels.values()].find((panel) => Boolean(panelCall(panel, panel.composer?.blocked)));
   600	    const attachmentsBlocked = Boolean(blockingPanel);
   601	    const blockedReason = blockingPanel && panelCall(blockingPanel, blockingPanel.composer?.blockedReason);
   602	    // The task banner is the single cancellation control. The composer only sends follow-ups.
   603	    const control = window.GrokbotChat.composerConnectionState({ offline: connectionStatus === "offline", busy, group,
   604	      live: !task && Boolean(streamingMessage()) && (!group || (!ui.input.value.trim() && !hasAttachments)) });
   605	    const live = control.live;
   606	    const noMembers = group && !currentConversation().member_ids?.length;
   607	    ui.send.disabled = control.offline || taskFinished || (live ? ((group || task) && (control.busy || !connected)) : control.busy || !connected || noMembers || (!ui.input.value.trim() && !hasAttachments) || pending || tooLong || attachmentsBlocked);
   608	    ui.send.dataset.mode = control.mode;
   609	    ui.send.title = control.title;
   610	    ui.send.setAttribute("aria-label", control.label);
   611	    ui.send.querySelector("use").setAttribute("href", control.icon);
   612	    ui.input.setInvalid(tooLong);
   613	    ui.hint.dataset.alert = String(Boolean(pending || tooLong || blockedReason));
   614	    ui.hint.textContent = taskFinished ? "Cette tâche est terminée ; poursuivez dans la conversation principale." : noMembers ? "Ajoutez un bot au groupe pour poursuivre." : pending ? "Vérifiez le dernier envoi pour poursuivre la conversation." : tooLong ? "Ce message est trop long. Raccourcissez-le pour l’envoyer." : typeof blockedReason === "string" ? blockedReason : task ? "Suivi réservé à cette sous-tâche · Entrée pour envoyer" : group && live ? "Écrivez pour envoyer un nouveau message, ou arrêtez les tours." : "Entrée pour envoyer · ⇧ Entrée pour une nouvelle ligne";
