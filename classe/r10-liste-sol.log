   650	  function leaveEmptyThread() {
   651	    if (!currentConversation() || currentConversation().messages.length || stagedOnEmptyThread()) return;
   652	    const draft = ui.input.value;
   653	    // Move the text, not a copy: selectConversation will remove the old draft key.
   654	    setComposerText("");
