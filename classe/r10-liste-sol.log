   423	  async function copyText(text) {
   424	    if (navigator.clipboard?.writeText) {
   425	      try { await navigator.clipboard.writeText(text); return; } catch { /* Native WebKit may require the selection fallback. */ }
   426	    }
   427	    const textarea = element("textarea", "visually-hidden");
   428	    textarea.value = text;
   429	    textarea.setAttribute("readonly", "");
   430	    document.body.append(textarea);
   431	    textarea.select();
   432	    try { if (!document.execCommand("copy")) throw new Error("Copy unavailable"); }
   433	    finally { textarea.remove(); }
   434	  }
