    12	
    13	const PASSAGE_LIMIT: usize = 500;
    14	const LINES_LIMIT: usize = 20;
    15	const LINE_LIMIT: usize = 240;
    16	const BLOCK_BUDGET: usize = 16_384;
    17	
    18	#[derive(Deserialize)]
    19	#[serde(deny_unknown_fields)]
    20	pub struct PageAnchor {
    21	    page_id: String,
    22	    source_version: String,
    23	    passage: String,
    24	}
    25	
    26	pub fn migrate(conn: &Connection) -> Result<(), ApiError> {
    27	    conn.execute_batch(
    28	        "CREATE TABLE IF NOT EXISTS wrapper_page_anchors (
    29	            conversation_id TEXT NOT NULL,
    30	            message_id TEXT NOT NULL,
    31	            page_id TEXT NOT NULL,
    32	            passage TEXT NOT NULL,
    33	            source_version TEXT NOT NULL,
    34	            state TEXT NOT NULL,
    35	            created_at INTEGER NOT NULL,
    36	            PRIMARY KEY (conversation_id, message_id)
    37	        );",
    38	    )?;
    39	    Ok(())
    40	}
    41	
    42	/// L'ancre appartient au premier envoi : un renvoi doit porter la même ancre
    43	/// (même Page, même passage rogné), ou aucune si le premier n'en avait pas.
    44	pub fn check_resend(
    45	    conn: &Connection,
    46	    conversation: &str,
    47	    message: &str,
    48	    anchor: Option<&PageAnchor>,
    49	) -> Result<(), ApiError> {
    50	    let stored: Option<(String, String)> = conn
    51	        .query_row(
    52	            "SELECT page_id, passage FROM wrapper_page_anchors WHERE conversation_id = ?1 AND message_id = ?2",
    53	            params![conversation, message],
    54	            |row| Ok((row.get(0)?, row.get(1)?)),
    55	        )
    56	        .optional()?;
    57	    let sent = anchor.map(|a| (a.page_id.as_str(), a.passage.trim()));
    58	    if stored
    59	        .as_ref()
    60	        .map(|(page, passage)| (page.as_str(), passage.as_str()))
    61	        != sent
    62	    {
    63	        return Err(ApiError::new(
    64	            409,
    65	            "Ce message a déjà été envoyé avec une autre ancre de Page : renvoyez-le tel quel.",
    66	        ));
    67	    }
    68	    Ok(())
    69	}
    70	
    71	/// Une sélection sur plusieurs cellules ou paragraphes porte des tabulations et des retours à la ligne,
    72	/// l'aperçu un espace à chaque frontière de bloc (`compile::BREAK`) : on compare les deux avec chaque suite
    73	/// de blancs (propriété Unicode White_Space) réduite à un seul espace, comme `collapsed` dans
    74	/// app/ui/panels/pages.js. Un blanc au milieu d'un mot, ou un blanc absent entre deux cellules, ne passe donc
    75	/// pas. Le passage reste stocké tel qu'envoyé.
    76	fn collapsed(text: &str) -> String {
    77	    text.split(char::is_whitespace)
    78	        .filter(|word| !word.is_empty())
    79	        .collect::<Vec<_>>()
    80	        .join(" ")
    81	}
    82	
    83	/// Refuse sans rien écrire ; l'appelant garde le message dans la même transaction.
    84	pub fn record(
    85	    conn: &Connection,
    86	    conversation: &str,
    87	    message: &str,
    88	    anchor: &PageAnchor,
    89	    mentions: &[Mention],
    90	    now_ms: u64,
    91	) -> Result<(), ApiError> {
    92	    let passage = anchor.passage.trim();
    93	    if passage.is_empty() || passage.chars().count() > PASSAGE_LIMIT {
    94	        return Err(ApiError::new(
    95	            400,
    96	            "Le passage cité doit contenir entre 1 et 500 caractères.",
    97	        ));
    98	    }
    99	    if anchor.source_version.len() != 64
   100	        || !anchor.source_version.bytes().all(|b| b.is_ascii_hexdigit())
   101	    {
   102	        return Err(ApiError::new(400, "Version de Page invalide."));
   103	    }
   104	    let (page_bot, shown): (String, String) = conn
   105	        .query_row(
   106	            "SELECT bot_id, preview FROM bot_pages WHERE id = ?1",
   107	            [&anchor.page_id],
   108	            |row| Ok((row.get(0)?, row.get(1)?)),
   109	        )
   110	        .optional()?
   111	        .ok_or_else(|| ApiError::new(404, "Cette Page est introuvable."))?;
   112	    let thread_bot: String = conn.query_row(
   113	        "SELECT bot_id FROM wrapper_conversations WHERE account_id = ?1 AND id = ?2",
   114	        params![ACCOUNT, conversation],
   115	        |row| row.get(0),
   116	    )?;
   117	    if page_bot != thread_bot {
   118	        return Err(ApiError::new(
   119	            409,
   120	            "Cette Page appartient à un autre bot que celui de ce fil.",
   121	        ));
   122	    }
   123	    if mentions.iter().any(|mention| mention.id != page_bot) {
   124	        return Err(ApiError::new(
