   271	pub fn startup(conn: &Connection) -> Result<(), ApiError> {
   272	    conn.pragma_update(None, "secure_delete", true)?;
   273	    let path = Path::new(
   274	        conn.path()
   275	            .ok_or_else(|| ApiError::new(500, "Recovery requires a file database."))?,
   276	    );
   277	    // Construction is inert (no status/auth/network calls). Recovery reactions
   278	    // only use the transaction, under the same no-I/O contract as normal hooks.
   279	    let provider = Provider::with_endpoints(path, Endpoints::default(), false);
   280	    let mut services = Services {
   281	        path,
   282	        provider: &provider,
   283	        connection: conn,
   284	        cancel: Arc::new(AtomicBool::new(false)),
   285	        bot_id: None,
   286	        host_mcp: false,
   287	    };
   288	    for run in store::runs_with_status(conn, RunStatus::Running)? {
   289	        run_loop::with_run_events(conn, &mut services, &run.run_id, |conn, _| {
   290	            let mut current = store::required(conn, &run.run_id)?;
   291	            if current.status == RunStatus::Running {
   292	                current.status = RunStatus::Interrupted;
   293	                store::save(conn, &current)?;
   294	                store::append_event(
   295	                    conn,
   296	                    &current.run_id,
   297	                    RunEventKind::Interrupted,
   298	                    &json!({"reason":"process_restart"}),
   299	                )?;
   300	            }
   301	            Ok(())
   302	        })?;
   303	    }
   304	    Ok(())
   305	}
