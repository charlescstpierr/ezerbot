   351	  function readPreference(key, fallback) {
   352	    try { return localStorage.getItem(key) ?? fallback; } catch { return fallback; }
   353	  }
   354	
   355	  function writePreference(key, value) {
   356	    try { localStorage.setItem(key, value); } catch { /* The chat still works when browser storage is unavailable. */ }
   357	  }
   358	
   359	  function removePreference(key) {
   360	    try { localStorage.removeItem(key); } catch { /* SQLite remains the source of conversation history. */ }
   361	  }
   362	
   363	  function draftKey(id = selectedId) { return `grokbot.draft.${id || "new"}`; }
   364	  function currentConversation() { return state.conversations.find((item) => item.id === selectedId); }
   365	  function botById(id) { return state.bots.find((bot) => bot.id === id); }
   366	  // Les bots supprimés restent dans l'état pour que leurs conversations gardent nom et couleur.
   367	  function liveBots() { return state.bots.filter((bot) => !bot.deleted); }
   368	  // Un choix devenu caduc (bot supprimé ailleurs) retombe sur le bot par défaut.
   369	  function chosenBot() { const bot = botById(chosenBotId); return bot && !bot.deleted ? bot : liveBots()[0]; }
   370	  function currentBot() { const conversation = currentConversation(); return conversation ? botById(conversation.bot_id) : chosenBot(); }
   420	    }, 4000);
   421	  }
