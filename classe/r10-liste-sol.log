   436	  async function api(path, body) {
   437	    const options = body === undefined ? {} : {
   438	      method: "POST",
   439	      headers: { "Content-Type": "application/json", "X-Grokbot-Request": "local" },
   440	      body: JSON.stringify(body),
   441	    };
   442	    const controller = new AbortController();
   443	    const timeout = setTimeout(() => controller.abort(), 15000);
   444	    try {
   445	      let response;
   446	      try { response = await fetch(path, { ...options, signal: controller.signal }); }
   447	      catch (error) {
   448	        showConnectionError(error);
   449	        throw new Error("La connexion au moteur local est interrompue.");
   450	      }
   451	      let data;
   452	      try { data = await response.json(); }
   453	      catch (error) { showConnectionError(error); throw new Error("Le moteur local a renvoyé une réponse illisible."); }
   454	      if (!response.ok) {
   455	        const error = new Error(data.error || "L’action n’a pas pu être terminée.");
   456	        error.status = response.status;
   457	        if (remoteAccessDisabled(response.status, data)) {
   458	          error.accessDisabled = true;
   459	          showConnectionError(error);
   460	        }
   461	        throw error;
   462	      }
   463	      return data;
   464	    } finally { clearTimeout(timeout); }
   465	  }
