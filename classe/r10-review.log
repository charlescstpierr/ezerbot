   307	pub fn routes(
   308	    app: &mut App,
   309	    method: &str,
   310	    path: &str,
   311	    body: &[u8],
   312	) -> Option<Result<ApiResponse, ApiError>> {
   313	    if method != "POST"
   314	        || !matches!(
   315	            path,
   316	            "/api/send"
   317	                | "/api/reconcile"
   318	                | "/api/messages/react"
   319	                | "/api/messages/resend"
   320	                | "/api/messages/delete"
   321	                | "/api/provider/signin"
   322	                | "/api/provider/test"
   323	                | "/api/provider/select"
   324	                | "/api/provider/cancel"
   325	                | "/api/provider/welcomed"
   326	                | "/api/provider/signout"
   327	                | "/api/stop"
   328	                | "/api/regenerate"
   329	                | "/api/conversations/reset"
   330	                | "/api/engine/config"
   331	        )
   332	    {
   333	        return None;
   334	    }
   335	    Some(route(app, path, body).map(ApiResponse::Json))
