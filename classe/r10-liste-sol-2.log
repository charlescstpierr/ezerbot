    59	/// The preview is derived from the source, and the passage of an anchor is checked against it: a Page
    60	/// written before the preview marked its block boundaries (`compile::BREAK`) would glue "Confort" and
    61	/// "19 €" and refuse the selection of both. Rebuild each ready Page's preview from its source; a second
    62	/// pass changes nothing, and a source that no longer compiles keeps what it had.
    63	fn refresh_previews(conn: &Connection) -> Result<(), ApiError> {
    64	    let ready: Vec<(String, String, String)> = {
    65	        let mut statement =
    66	            conn.prepare("SELECT id, source, preview FROM bot_pages WHERE status = 'ready'")?;
    67	        let rows = statement.query_map([], |row| Ok((row.get(0)?, row.get(1)?, row.get(2)?)))?;
    68	        rows.collect::<Result<_, _>>()?
    69	    };
    70	    for (id, source, stored) in ready {
    71	        if let Ok(page) = compile::compile(&source) {
    72	            if page.preview != stored {
    73	                conn.execute(
    74	                    "UPDATE bot_pages SET preview = ?2 WHERE id = ?1",
    75	                    params![id, page.preview],
    76	                )?;
    77	            }
    78	        }
    79	    }
    80	    Ok(())
    81	}
